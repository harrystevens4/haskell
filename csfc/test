#!/bin/bash

test_count=0
assert_output() {
	output="$(./csfc "$1")"
	if [ $? -ne 0 ]; then
		echo "test $test_count failed"
		echo "command returned with non zero exit status"
		echo "./csfc \"$1\""
		echo $output
		exit 1
	fi
	test_count=$(echo "$test_count+1" | bc)
	if (( $(echo "$output != $2" | bc) )); then
		echo "test $test_count failed"
		echo "./csfc \"$1\""
		echo "$output != $2"
		exit 1
	fi
}

assert_output '(1+3) * (4/2)' 8
assert_output '(1+2+3)' 6
assert_output '1+2+3' 6
assert_output '1 + 2 + 3' 6
assert_output '-5' -5
assert_output '1+2+3' 6
assert_output '10-4' 6
assert_output '3*5' 15
assert_output '12/4' 3
assert_output '2.5+3.5' 6
assert_output '1+2*3' 7
assert_output '(1+2) * 3' 9
assert_output '10-4/2+1' 9
assert_output '2*(3+4) * 2' 28
assert_output '-5+3' -2
assert_output '5*-3' -15
assert_output '-10/-2' 5
assert_output '(-2)*(-3)+(-4)' 2
assert_output '0*100' 0
assert_output '0/5' 0
assert_output '2^3' 8
assert_output '5^2' 25
assert_output '10^4' 10000
assert_output '5^0' 1
assert_output '0^5' 0
assert_output '7^1' 7
assert_output '1^50' 1
assert_output '2+3^2' 11
assert_output '2*3^2' 18
assert_output '(2*3)^2' 36
assert_output '(-2)^3' -8
assert_output '(-2)^4' 16
assert_output '4^-1' 0.25

echo "all tests pass"
